# .env.example
# Berisi template environment variables untuk aplikasi E-Office TUBABA

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://app.tubaba.go.id/api
NEXT_PUBLIC_API_TIMEOUT=10000

# App Configuration
NEXT_PUBLIC_APP_NAME="E-Office TUBABA"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_ENV="development" # development | production

# (Opsional) Kunci Rahasia untuk Server-Side (Tidak berawalan NEXT_PUBLIC_)
# JWT_SECRET=your_super_secret_key_here